{
  "info": {
    "name": "GrossPay API — Bangladesh (BDT · bKash)",
    "description": "Requests for the GrossPay Bangladesh integration. Select the **GrossPay BD — Test** environment and set `apiKey`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "merchantRef",
      "value": ""
    },
    {
      "key": "newRef",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create pay-in (debit)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/init",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "init"
              ]
            },
            "description": "Creates a bKash deposit. Open `hosted_url` from the response in a browser to pay.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_amount\": \"1000.00\",\n  \"order_currency\": \"BDT\",\n  \"intent\": \"debit\",\n  \"route_kind\": \"wallet\",\n  \"merchant_ref\": \"{{newRef}}\",\n  \"holder_ref\": \"{{holderRef}}\",\n  \"holder_name\": \"Rahim Uddin\",\n  \"callback_uri\": \"{{callbackUri}}\",\n  \"return_uri\": \"{{returnUri}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.test('2xx and not an error envelope', () => { pm.expect(pm.response.code).to.be.within(200,299); pm.expect(d.ok).to.not.eql(false); });",
                  "if (d.payment_id) { pm.collectionVariables.set('paymentId', d.payment_id); }",
                  "if (d.merchant_ref) { pm.collectionVariables.set('merchantRef', d.merchant_ref); }"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('newRef', 'order_bd_' + Date.now());"
                ]
              }
            }
          ]
        },
        {
          "name": "Create payout (credit)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/init",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "init"
              ]
            },
            "description": "Sends a payout to a personal bKash wallet.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_amount\": \"1500.00\",\n  \"order_currency\": \"BDT\",\n  \"intent\": \"credit\",\n  \"route_kind\": \"wallet\",\n  \"merchant_ref\": \"{{newRef}}\",\n  \"holder_ref\": \"{{holderRef}}\",\n  \"callback_uri\": \"{{callbackUri}}\",\n  \"credit_details\": {\n    \"wallet_number\": \"01712345678\",\n    \"payee_title\": \"Rahim Uddin\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.test('2xx and not an error envelope', () => { pm.expect(pm.response.code).to.be.within(200,299); pm.expect(d.ok).to.not.eql(false); });",
                  "if (d.payment_id) { pm.collectionVariables.set('paymentId', d.payment_id); }",
                  "if (d.merchant_ref) { pm.collectionVariables.set('merchantRef', d.merchant_ref); }"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('newRef', 'withdraw_bd_' + Date.now());"
                ]
              }
            }
          ]
        },
        {
          "name": "Get state by payment_id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/{{paymentId}}/state",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "{{paymentId}}",
                "state"
              ]
            },
            "description": "Uses `paymentId` saved by the last create request."
          }
        },
        {
          "name": "Get state by merchant_ref",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/{{merchantRef}}/state",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "{{merchantRef}}",
                "state"
              ]
            },
            "description": "Lookup by your own reference."
          }
        },
        {
          "name": "Payout with invalid bKash number (expect 474)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/init",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "init"
              ]
            },
            "description": "Negative test: expects error envelope with fault.code 474.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_amount\": \"1500.00\",\n  \"order_currency\": \"BDT\",\n  \"intent\": \"credit\",\n  \"route_kind\": \"wallet\",\n  \"merchant_ref\": \"{{newRef}}\",\n  \"holder_ref\": \"{{holderRef}}\",\n  \"callback_uri\": \"{{callbackUri}}\",\n  \"credit_details\": {\n    \"wallet_number\": \"0171234\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.test('fault.code is 474', () => pm.expect(d.fault && d.fault.code).to.eql('474'));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('newRef', 'withdraw_bd_' + Date.now());"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Disputes",
      "item": [
        {
          "name": "Escalate payment",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/{{paymentId}}/escalate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "{{paymentId}}",
                "escalate"
              ]
            },
            "description": "multipart/form-data. Choose 1–3 files (PDF/JPEG/PNG, ≤ 5 MB each).",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file1",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "comment",
                  "type": "text",
                  "value": "Paid via bKash, TrxID 9A1B2C3D4E"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Partner",
      "item": [
        {
          "name": "Get balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/partner/ledger_balance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "partner",
                "ledger_balance"
              ]
            },
            "description": ""
          }
        }
      ]
    }
  ]
}